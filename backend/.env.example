# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy file này thành .env và điền giá trị
# ============================================================

# MongoDB (bắt buộc)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/<dbname>?appName=Cluster0

# CORS: danh sách origin được phép (phân cách bằng dấu phẩy)
CORS_ORIGIN=http://localhost:5173

# JWT
PORT=5000
JWT_SECRET=<random-secret-at-least-32-chars>
JWT_EXPIRES_IN=7d

# ============================================================
# CLOUDINARY - BẮT BUỘC để ảnh hiển thị trên nhiều máy
# ============================================================
# Nếu KHÔNG cấu hình: ảnh chỉ lưu local, người dùng khác KHÔNG xem được.
# Đăng ký miễn phí: https://cloudinary.com → Dashboard → Copy 3 giá trị dưới
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
